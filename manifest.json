{
  "manifest_version": 3,
  "name": "Bookmarks Validator",
  "version": "1.0",
  "description": "Find and remove broken or unavailable bookmarks.",
  "permissions": [
    "bookmarks",
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bookmarks Validator"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
